# ==========================================================
# Mio Wealth - Environment Configuration Template
# Copy this file to .env on your fresh machine/pod:
#   cp .env.example .env
# ==========================================================

# Port Configuration
APP_PORT=8080
POSTGRES_PORT=5432

# Database Credentials & Schema
POSTGRES_DB=investmanDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_production_password_here
DB_SCHEMA=public

# Security & JWT
JWT_SECRET=your_custom_secure_256_bit_random_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8080

